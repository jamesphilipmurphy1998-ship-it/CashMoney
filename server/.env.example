# Copy this file to server/.env and fill in your Supabase project values.
# Leave it absent (or blank) to keep using the local JSON file store.

# Project URL — Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Use the service_role key for a trusted backend (it bypasses row-level
# security). Keep it secret — never ship it to the browser.
# Supabase dashboard → Project Settings → API → service_role secret
SUPABASE_KEY=your-service-role-key

# Optional: port the server listens on (default 4178)
# PORT=4178

# Live S&P 500 quotes (Finnhub). Get a free key at https://finnhub.io/register
# (no card). With this set, the server fetches live prices in the background.
FINNHUB_KEY=your-finnhub-key
